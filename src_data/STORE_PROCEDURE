
CREATE OR ALTER PROCEDURE DBO.EMP_PROJ AS
BEGIN
	DECLARE @start_time DATETIME, @end_time DATETIME;
BEGIN TRY
   PRINT'============================='
   PRINT' LOAD EMP'
   PRINT'============================='
  SET @START_TIME = GETDATE();
TRUNCATE TABLE EMP_FF_SRC;
 BULK INSERT [SQL_TRAINING_2024].[dbo].[EMP_FF_SRC]
 FROM 'C:\srcfiles\EMP_FF_SRC.txt'
 WITH (
	FIRSTROW = 2,
	FIELDTERMINATOR = '|',
	TABLOCK
	);
	SET @end_time = GETDATE();
	PRINT CAST(DATEDIFF(second, @start_time, @end_time) AS VARCHAR) + 'SECONDS';
	END TRY
	BEGIN CATCH
	  PRINT'============================='
	  PRINT'ERROR OCCURESD'
	  PRINT'ERROR MESSAGE'+ ERROR_MESSAGE();
	  PRINT'ERROR MESSAGE'+ CAST (ERROR_NUMBER() AS VARCHAR);
	  PRINT'ERROR MESSAGE'+ CAST (ERROR_STATE() AS VARCHAR);
	  PRINT'============================='
	END CATCH
END;		

EXEC DBO.EMP_PROJ;
